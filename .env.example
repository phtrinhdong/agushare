# =========================================================
# 服务端环境变量 (复制为 .env 后修改)
#   cp .env.example .env
# 注意: .env 已在 .gitignore 中,不会被推到 git
# =========================================================

# 对外暴露端口 (默认 8000)
HOST_PORT=8000

# Web 看板的 HTTP Basic Auth (公网部署强烈建议开启)
# 留空表示不开启认证
AGU_AUTH_USER=admin
AGU_AUTH_PASS=请改成强密码

# 时区 (一般不用改)
TZ=Asia/Shanghai
